# Ollama local (100% gratuito y sin API keys externas)
OLLAMA_BASE_URL=http://localhost:11434

# Modelos locales del Doble Agente + Visión (optimizados para Laptop GTX 1650 Ti 4 GB VRAM)
EXECUTOR_MODEL=qwen2.5:1.5b
SUPERVISOR_MODEL=qwen2.5:1.5b
# Alternativa de visión: qwen2.5vl:3b
VISION_MODEL=moondream

# Circuit Breaker y Fast-Path Supervisor
MAX_SUPERVISOR_RETRIES=2
FAST_SUPERVISOR=true

# Base de datos local de agenda y memoria (SQLite offline)
AGENDA_DB_PATH=jarvis_agenda.db
MEMORY_DB_PATH=jarvis_memory.db

# Servidor Hub
HUB_HOST=0.0.0.0
HUB_PORT=8000

# Notificaciones push gratuitas opcionales (ntfy.sh) y polling de recordatorios
NTFY_TOPIC=
REMINDER_POLL_SECONDS=15.0
